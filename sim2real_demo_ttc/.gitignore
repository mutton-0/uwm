# 激活缓存（可由 scripts/g2_cache.py 从 events_all.jsonl 重建）
cache/
variants/*/cache/
# 帧软链
frames/
variants/*/frames/
# 抽检渲染图（可由 scripts/g1_visualize.py 重建）
mining/inspect/*.png
variants/*/mining/inspect/*.png
# 运行日志
logs/
# 各候选侧的 G1 表征缓存（均可由 results/<model>_g1_adapter/run_g1_cache*.py 重建）
variants/*/dd_cache/
variants/*/ltf_cache/
variants/*/ddv2_cache/
variants/*/alpa_cache/
variants/*/autovla_cache/
# T-I 域配对的逐层激活（可由 scripts/i_axis_extract.py 从 variants/i_domain/frames 重建）
variants/*/acts_*.npz
# tier_m_v3 的 mining 是指向 tier_m/mining 的绝对路径软链（重建见 configs/tier_m_v3.yaml 头注）
variants/tier_m_v3/mining
# pilot post-train 的特征缓存（可由 scripts/p1_cache_query_states.py 一遍前向重建）
variants/*/pilot_query_states.npz
# 第二场景（前车急刹）的表征缓存与候选池（均可由 lb1/lb2 + 各适配器重建）
variants/lead_brake/cache/
variants/lead_brake/mining/_lb_pool.npy
# NAVSIM 独立语料的表征缓存（可由 ns1 + 各适配器重建）
variants/navsim_corpus/cache/
variants/navsim_corpus/dd_cache/
variants/navsim_corpus/ltf_cache/
variants/navsim_corpus/ddv2_cache/
# G-VS 的 SAM 伪 GT 与 token 特征（均可由 gvs1/gvs3 重建）
variants/*/sam_gt/
variants/*/gvs/
variants/*/gvs_tokens_*.npz

# F/I 轴的逐事件激活（体量大，均可由对应 extract 脚本重建）
results/vfaith_acts_*.npz
results/vbright_acts_*.npz
results/vdecel_acts_*.npz
results/harsh_acts_*.npz
results/v_domain*.np[yz]
results/vspeed_*.npy
# 遮挡渲染图（可由 pool_to_c_work.py / vla_export_boxes.py 重建）
work_c_*/
work_gvs_*/

# ---------- 以下是 demo/sim2real-ttc-clean 整理时新增的 ----------
# 分析产出和缓存不进仓库。原文件还在 sim2real/demo-v3-repe-mainline 分支,恢复方法见 README"数据和中间结果"一节
results/**/*.json
results/**/*.jsonl
results/**/*.np[yz]
results/**/*.pt
results/**/*.png
results/**/*.pdf
results/**/*.html
variants/**/*.json
variants/**/*.jsonl
variants/**/*.np[yz]
variants/**/*.png
probe_v0/**/*.json
probe_v0/**/*.png
probe_v0/**/*.pdf
# 第二轮结果在另一台机器上产出,从来没进过 git;probe_v0 里原来有两个软链接指向这里
results_5090/
probe_v0/data
probe_v0/tb
# 论文源文件和 PDF 不放在代码仓库
paper_*/
# 已作废的结果
results/voided_*/

# ---------- 以下来自 sky-lab 通用 .gitignore(templates/.gitignore 的默认生效部分) ----------
# ---------- 数据:不进仓库,README 里写清去哪下载 ----------
# 需要放进仓库的小样例,用 ! 单独放行,比如 !data/sample/
data/*
!data/.gitkeep
!data/README.md

# ---------- 模型权重 ----------
checkpoints/
ckpt/
weights/
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx
*.engine
*.h5

# ---------- 实验输出和日志 ----------
outputs/
multirun/
logs/
runs/
wandb/
lightning_logs/
mlruns/
*.log

# ---------- 传感器数据、视频、压缩包:放 NAS / 网盘,README 里放链接 ----------
*.bag
*.db3
*.mcap
*.pcd
*.mp4
*.avi
*.mov
*.mkv
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# ---------- 密钥:绝对不能提交 ----------
.env
.env.*
!.env.example
*.pem
*.key

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---------- 虚拟环境 ----------
.venv/
venv/
.conda/

# ---------- C++ 编译产物 ----------
*.o
CMakeFiles/
CMakeCache.txt

# ---------- 编辑器和系统文件 ----------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
