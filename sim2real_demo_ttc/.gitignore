# 激活缓存（可由 scripts/g2_cache.py 从 events_all.jsonl 重建）
cache/
variants/*/cache/
# 帧软链
frames/
variants/*/frames/
# 抽检渲染图（可由 scripts/g1_visualize.py 重建）
mining/inspect/*.png
variants/*/mining/inspect/*.png
# 运行日志
logs/
# 各候选侧的 G1 表征缓存（均可由 results/<model>_g1_adapter/run_g1_cache*.py 重建）
variants/*/dd_cache/
variants/*/ltf_cache/
variants/*/ddv2_cache/
variants/*/alpa_cache/
variants/*/autovla_cache/
# T-I 域配对的逐层激活（可由 scripts/i_axis_extract.py 从 variants/i_domain/frames 重建）
variants/*/acts_*.npz
# tier_m_v3 的 mining 是指向 tier_m/mining 的绝对路径软链（重建见 configs/tier_m_v3.yaml 头注）
variants/tier_m_v3/mining
# pilot post-train 的特征缓存（可由 scripts/p1_cache_query_states.py 一遍前向重建）
variants/*/pilot_query_states.npz
